<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The source-generated Windows job object interop (Processes/Native) needs it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pyxie.Data\Pyxie.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pyxie.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pyxie's base sandbox image: the Dockerfile and the scripts that start a sandbox, set its firewall, and run its commands. -->
    <EmbeddedResource Include="Sandboxes\Image\*" LogicalName="Pyxie.Sandboxes.Image.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
