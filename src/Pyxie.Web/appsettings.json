{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Urls": "http://localhost:5280",
  "Database": {
    "Provider": "Sqlite"
  },
  "Pipeline": {
    "Workers": 5,
    "PollIntervalSeconds": 5,
    "RoundTimeoutMinutes": 60
  },
  "Workspace": {
    "Root": ""
  },
  "Blazorise": {
    "ProductToken": ""
  }
}
