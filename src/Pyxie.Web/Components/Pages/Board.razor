@page "/"
@using Pyxie.Data.Enums
@using Pyxie.Data.Services.Rules
@using Pyxie.Web.Components.Board
@using Pyxie.Web.Components.Projects

<PageTitle>Board</PageTitle>

<div class="board-page">
	@if (_linkError is not null)
	{
		<Alert Color="Color.Warning" Visible="true">@_linkError</Alert>
	}
	@if (_loading)
	{
		<div class="board-status">Loading</div>
	}
	else if (_project is null)
	{
		<NoProjectOpen />
	}
	else
	{
		int shownProject = _project.Id;
		<div class="board-scroll" @key="_project.Id">
			<div class="board" style="--lane-count: @CardLifecycleRules.BoardLanes.Count">
				@foreach (CardLane lane in CardLifecycleRules.BoardLanes)
				{
					<BoardLane @ref="_lanes[lane]" Lane="@lane" Cards="@CardsIn(lane)" CardClicked="@(card => OpenEditor(card, shownProject))" AddClicked="@(() => OpenEditor(null, shownProject))" RetryClicked="@(card => RetryAsync(card, shownProject))" CloseClicked="@(card => CloseAsync(card, shownProject))" Refusals="@_refusals" />
				}
			</div>
		</div>
	}
</div>

<CascadingValue Name="DisplayedProjectId" Value="@_project?.Id" @key="EditorKey" IsFixed="true">
	<CardEditor @ref="_editor" Project="_project" Categories="@_categories" Agents="@_agents" Changed="@AnnounceChange" />
</CascadingValue>
