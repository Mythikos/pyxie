<div class="pyx-panel repo-header">
	<div class="repo-title">
		<h1 class="repo-name">@ProjectName</h1>
		<span class="repo-branch" title="Target branch"><Icon Name="@("lock")" />@Repository.TargetBranch</span>
	</div>
	<dl class="repo-facts">
		<dt>Origin</dt>
		<dd class="repo-origin">
			<code class="repo-path" tabindex="0">@OriginText</code>
			<RepositoryCopyButton @key="OriginText" Text="@OriginText" Label="Copy origin" />
		</dd>
		<dt>Hub</dt>
		<dd class="repo-hub">
			<code class="repo-path" tabindex="0">@Repository.Path</code>
			<RepositoryCopyButton @key="Repository.Path" Text="@Repository.Path" Label="Copy hub path" />
		</dd>
	</dl>
</div>
