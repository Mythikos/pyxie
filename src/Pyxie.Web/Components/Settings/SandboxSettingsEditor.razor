@inherits Pyxie.Web.Components.Projects.ProjectEditorComponent
@using Pyxie.Runtime.Sandboxes
@using Pyxie.Runtime.Workspaces

<SettingsPanel Section="SettingsSections.Sandbox" style="--settings-panel-gap: 16px; --settings-panel-bottom: 20px">
	@if (_error is not null)
	{
		<Alert Color="Color.Danger" Visible="true">@_error</Alert>
	}
	@* A failed build's error goes with its log below, so a refused save never leaves the log without it. *@
	@if (FailedBuild is SandboxImageBuild failed)
	{
		<Alert Color="Color.Danger" Visible="true">@failed.Error</Alert>
	}
	<div class="sandbox-columns">
		<div class="sandbox-editor">
			<label for="sandbox-dockerfile" class="sandbox-label">Dockerfile</label>
			<MemoInput ElementId="sandbox-dockerfile" @bind-Value="@_dockerfile" Rows="13" Class="sandbox-dockerfile" spellcheck="false" />
			<div class="sandbox-actions">
				@if (BuiltTag is string tag)
				{
					<span class="sandbox-built"><Icon Name="IconName.CheckCircle" IconStyle="IconStyle.Solid" />Built</span>
					<code class="sandbox-tag">@tag</code>
				}
				<div class="sandbox-buttons">
					<span title="@BuildBlockedText">
						<Button Color="Color.Default" Disabled="@(HasChanges || !ImageBuilds.CanStart)" Loading="@IsBuilding" Clicked="@Build">@(IsBuilding ? "Building" : "Build")</Button>
					</span>
					@if (CancellableBuild is SandboxImageBuild shown)
					{
						<span @onclick="@(press => Cancel(press, shown))"><Button Color="Color.Default">Cancel</Button></span>
					}
					<Button Class="sandbox-save" Color="Color.Primary" Disabled="@(!HasChanges || _saving)" Clicked="@SaveAsync">Save</Button>
				</div>
			</div>
			@if (FailedBuild?.LogTail is string log)
			{
				<pre class="sandbox-build-log">@log</pre>
			}
		</div>
		@if (_signIns is SandboxSignInStatus signIns)
		{
			<div class="sandbox-side">
				<h3 class="sandbox-side-title">Sign-ins</h3>
				<ul class="sandbox-signins">
					@foreach (HarnessCredentialGuide guide in HarnessCredentialGuide.From(signIns))
					{
						<SignInRow Name="@guide.Name" Found="@guide.Found" Fix="@guide.Instructions" />
					}
				</ul>
			</div>
		}
	</div>
</SettingsPanel>
