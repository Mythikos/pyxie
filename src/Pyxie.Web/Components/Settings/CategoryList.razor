@inherits Pyxie.Web.Components.Projects.ProjectEditorComponent
<SettingsPanel Section="SettingsSections.Categories">
	@if (_error is not null)
	{
		<Alert Color="Color.Danger" Visible="true">@_error</Alert>
	}
	<div class="category-row">
		@foreach (Category category in _categories)
		{
			@if (_editingId == category.Id)
			{
				CategoryChipAppearance editing = CategoryChipAppearance.Of(_editColor);
				<form @key="category.Id" class="@($"category-editor {editing.Classes}")" style="@editing.Style" @onsubmit="@SaveEditAsync">
					<TextInput @ref="_editInput" @bind-Value="_editName" Disabled="@_busy" aria-label="@($"New name for {category.Name}")" />
					<CategoryColorPicker @bind-Value="_editColor" Subject="@category.Name" Disabled="@_busy" />
					<Button Type="ButtonType.Submit" Color="Color.Primary" Size="Size.Small" Disabled="@_busy" aria-label="@($"Save {category.Name}")">Save</Button>
					<Button Type="ButtonType.Button" Color="Color.Default" Size="Size.Small" Disabled="@_busy" Clicked="@CancelEdit" aria-label="@($"Cancel editing {category.Name}")">Cancel</Button>
				</form>
			}
			else
			{
				CategoryChipAppearance chip = CategoryChipAppearance.Of(category.Color);
				<span @key="category.Id" class="@($"category-chip {chip.Classes}")" style="@chip.Style">
					<button type="button" class="category-name" @ref="_chips[category.Id]" disabled="@_busy" aria-label="@($"Edit {category.Name}")" @onclick="@(() => BeginEdit(category))">@category.Name</button>
					<button type="button" class="category-remove" disabled="@_busy" aria-label="@($"Delete {category.Name}")" @onclick="@(press => DeleteAsync(press, category))"><Icon Name="IconName.Times" /></button>
				</span>
			}
		}
		<form class="category-add" @onsubmit="@AddAsync">
			<label for="new-category" class="pyx-visually-hidden">New category</label>
			<TextInput @ref="_newInput" ElementId="new-category" Value="@_newName" ValueChanged="@OnNewNameChanged" Disabled="@_busy" Placeholder="New category" />
			<CategoryColorPicker Value="@_newColor" ValueChanged="@OnNewColorChanged" Disabled="@_busy" />
			<Button Type="ButtonType.Submit" Color="Color.Default" Disabled="@_busy">Add</Button>
		</form>
	</div>
</SettingsPanel>
