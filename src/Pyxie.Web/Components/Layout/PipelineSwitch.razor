<div class="pipeline-switch">
	<span class="@PillClass">
		<PyxieMark Drawing="@(IsRunning ? PyxieMarkDrawing.Awake : PyxieMarkDrawing.Asleep)" Size="22" />
		<span class="pipeline-state">@StateText</span>
		@if (IsRunning)
		{
			<span class="pipeline-capacity">@CapacityText</span>
		}
	</span>
	@if (StopReason is not null)
	{
		<span class="pipeline-stop-reason" role="status">@StopReason</span>
	}
	@{
		bool shownRunning = IsRunning;
	}
	<span title="@StartBlockedText" @onclick="@(press => Press(press, shownRunning))">
		<Button Class="@ActionClass" Color="@(IsRunning ? Color.Default : Color.Primary)" Disabled="@(!IsRunning && !ProjectOpen)"><svg class="pipeline-glyph" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
			@if (IsRunning)
			{
				<rect x="1.5" y="1.5" width="9" height="9" rx="1.5" fill="currentColor" />
			}
			else
			{
				<path d="M3 1.8v8.4L10 6z" fill="currentColor" />
			}
		</svg>@ActionText</Button>
	</span>
</div>
